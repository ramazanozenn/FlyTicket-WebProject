<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Admin Login - FlyTicket</title>
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/css/bootstrap.min.css" rel="stylesheet">
    <!-- style.css dosyasını buraya eklemeyi unutma -->
    <link rel="stylesheet" href="/css/style.css"> 
</head>
<body class="d-flex align-items-center justify-content-center vh-100">

<div class="card shadow-lg p-4" style="width: 100%; max-width: 400px; border-radius: 15px;">
    <div class="card-body">
        <h2 class="text-center mb-4 fw-bold">FlyTicket Admin</h2>
        
        <form action="/admin/login" method="POST">
            <div class="mb-3">
                <label class="form-label fw-bold">Username</label>
                <input type="text" name="username" class="form-control" placeholder="admin" required>
            </div>
            <div class="mb-4">
                <label class="form-label fw-bold">Password</label>
                <input type="password" name="password" class="form-control" placeholder="••••••" required>
            </div>
            <div class="d-grid">
                <button type="submit" class="btn btn-primary btn-lg fw-bold">Login</button>
            </div>
        </form>
    </div>
</div>

<!-- Footer (Admin login sayfasında da görünecek) -->
<footer class="modern-footer">
    <div class="container text-center">
        <div class="footer-container">
            <div class="footer-academic-text">
                Developed for <strong>CENG 3502 Dynamic Web Course</strong>
            </div>
        </div>
    </div>
</footer>

</body>
</html>