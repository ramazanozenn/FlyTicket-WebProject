<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>My Tickets - FlyTicket</title>
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/css/bootstrap.min.css" rel="stylesheet">
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css">
    <link rel="stylesheet" href="/css/style.css">
    <style>
        .ticket-card { border-left: 5px solid #007bff; transition: 0.3s; border-radius: 12px;}
        .ticket-card:hover { transform: translateY(-5px); box-shadow: 0 10px 20px rgba(0,0,0,0.1) !important; }
        .pnr-badge { background-color: #e7f3ff; color: #007bff; font-weight: bold; padding: 5px 12px; border-radius: 8px; }
    </style>
</head>
<body class="bg-light d-flex flex-column min-vh-100">

<nav class="navbar navbar-dark bg-primary mb-4 shadow-sm">
    <div class="container">
        <a class="navbar-brand fw-bold" href="/">
            <i class="fas fa-plane-departure me-2"></i>FlyTicket
        </a>
        <div class="ms-auto d-flex align-items-center">
            <% if (user) { %>
                <span class="text-white me-3 small">
                    <i class="fas fa-user-circle me-1"></i> Welcome, <strong><%= user.name %></strong>
                </span>
                <a href="/my-tickets" class="btn btn-info btn-sm rounded-pill fw-bold me-2 px-3 text-white">My Tickets</a>
                <a href="/logout" class="btn btn-light btn-sm rounded-pill fw-bold px-3" style="color: #007bff;">Logout</a>
            <% } else { %>
                <a href="/login" class="btn btn-outline-light btn-sm rounded-pill me-2 px-3">Login</a>
                <a href="/register" class="btn btn-light btn-sm rounded-pill px-3 fw-bold" style="color: #007bff;">Register</a>
            <% } %>

            <% if (typeof isAdmin !== 'undefined' && isAdmin) { %>
                <a href="/admin/dashboard" class="btn btn-danger btn-sm rounded-pill ms-3 fw-bold px-3">Admin Panel</a>
            <% } %>
        </div>
    </div>
</nav>

<main class="flex-grow-1 container py-4">
    <h2 class="mb-4" style="font-weight: 700; color: #2c3e50;"><i class="fas fa-ticket-alt me-2"></i>My Booked Tickets</h2>

    <% if (tickets.length > 0) { %>
        <div class="row">
            <% tickets.forEach(ticket => { %>
                <div class="col-md-6 mb-4">
                    <div class="card ticket-card border-0 shadow-sm h-100">
                        <div class="card-body p-4">
                            <div class="d-flex justify-content-between align-items-center mb-3">
                                <span class="pnr-badge">PNR: <%= ticket.pnr %></span>
                                <span class="badge bg-light text-dark border">Seat: <strong><%= ticket.seat_number %></strong></span>
                            </div>
                            
                            <h5 class="fw-bold mb-2" style="color: #34495e;">
                                <%= ticket.flight.from_city %> <i class="fa-solid fa-arrow-right mx-2 text-muted small"></i> <%= ticket.flight.to_city %>
                            </h5>
                            
                            <p class="text-muted mb-3 small">
                                <i class="fa-regular fa-calendar me-1"></i> 
                                <%= new Date(ticket.flight.departure_time).toLocaleDateString('tr-TR') %> 
                                <i class="fa-regular fa-clock ms-2 me-1"></i>
                                <%= new Date(ticket.flight.departure_time).toLocaleTimeString('tr-TR', {hour: '2-digit', minute:'2-digit'}) %>
                            </p>
                            
                            <div class="border-top pt-3 d-flex justify-content-between align-items-center">
                                <span class="text-primary fw-bold fs-5"><%= ticket.flight.price %> TL</span>
                                <span class="badge bg-success rounded-pill px-3 py-2"><i class="fas fa-check-circle me-1"></i> Confirmed</span>
                            </div>
                        </div>
                    </div>
                </div>
            <% }) %>
        </div>
    <% } else { %>
        <div class="text-center py-5 bg-white rounded-3 shadow-sm border-0">
            <i class="fas fa-ticket-alt fa-3x text-muted mb-3 opacity-50"></i>
            <h4 class="text-muted">You haven't booked any tickets yet.</h4>
            <a href="/" class="btn btn-primary mt-3 rounded-pill px-4 fw-bold">Search and Book Now</a>
        </div>
    <% } %>
</main>

<footer class="modern-footer mt-auto">
    <div class="container">
        <div class="footer-container">
            <a href="https://www.linkedin.com/in/ramazan-%C3%B6zen-6a6488336/" target="_blank" class="linkedin-logo">
                <i class="fab fa-linkedin" style="font-size: 24px; color: #0077b5;"></i>
            </a>
            <div class="footer-academic-text mt-2 text-muted small">
                Developed for <strong>CENG 3502 Dynamic Web Course</strong>
            </div>
        </div>
    </div>
</footer>

</body>
</html>