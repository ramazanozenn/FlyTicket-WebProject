<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Success - FlyTicket</title>
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/css/bootstrap.min.css" rel="stylesheet">
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css">
    <link rel="stylesheet" href="/css/style.css">
    <style>
        @media print {
            .no-print { display: none !important; }
            .card { border: 2px solid #ccc !important; box-shadow: none !important; }
            body { background-color: white !important; }
        }
    </style>
</head>
<body class="bg-light d-flex flex-column min-vh-100">

<nav class="navbar navbar-dark bg-primary mb-4 shadow-sm no-print">
    <div class="container">
        <a class="navbar-brand fw-bold" href="/">
            <i class="fas fa-plane-departure me-2"></i>FlyTicket
        </a>
    </div>
</nav>

<main class="flex-grow-1 container py-5 d-flex align-items-center justify-content-center">
    <div class="card shadow-lg border-0" style="max-width: 600px; width: 100%; border-radius: 15px;">
        <div class="card-body p-5 text-center">
            
            <div class="text-success mb-4">
                <i class="fa-solid fa-circle-check" style="font-size: 5rem;"></i>
            </div>
            <h2 class="fw-bold mb-3 text-success">Reservation Successful!</h2>
            <p class="text-muted fs-5">Thank you, <strong><%= ticket.passenger_name %> <%= ticket.passenger_surname %></strong>. Your flight is confirmed.</p>
            
            <div class="bg-light p-4 rounded-3 text-start my-4 border">
                <div class="d-flex justify-content-between align-items-center mb-3">
                    <span class="badge bg-primary fs-6 p-2">PNR: <%= pnr %></span>
                    <span class="badge bg-secondary fs-6 p-2">Seat: <%= seat %></span>
                </div>
                <hr>
                <p class="mb-2"><i class="fa-solid fa-plane-departure me-2 text-primary"></i><strong>Route:</strong> <%= flight.from_city %> ➔ <%= flight.to_city %></p>
                <p class="mb-2"><i class="fa-regular fa-calendar me-2 text-primary"></i><strong>Date:</strong> <%= new Date(flight.departure_time).toLocaleDateString('tr-TR') %></p>
                <p class="mb-0"><i class="fa-regular fa-clock me-2 text-primary"></i><strong>Time:</strong> <%= new Date(flight.departure_time).toLocaleTimeString('tr-TR', {hour: '2-digit', minute:'2-digit'}) %></p>
            </div>

            <div class="no-print mt-4">
                <button onclick="window.print()" class="btn btn-outline-secondary px-4 py-2 me-2 rounded-pill fw-bold">
                    <i class="fas fa-file-pdf me-1"></i> Download E-Ticket
                </button>
                <a href="/" class="btn btn-primary px-4 py-2 rounded-pill fw-bold shadow-sm">
                    <i class="fa-solid fa-house me-1"></i> Return to Home
                </a>
            </div>

        </div>
    </div>
</main>

<footer class="modern-footer mt-auto no-print">
    <div class="container">
        <div class="footer-container text-center">
            <a href="https://www.linkedin.com/in/ramazan-%C3%B6zen-6a6488336/" target="_blank" class="linkedin-logo">
                <i class="fab fa-linkedin" style="font-size: 24px; color: #0077b5;"></i>
            </a>
            <div class="footer-academic-text mt-2 text-muted small">
                Developed for <strong>CENG 3502 Dynamic Web Course</strong>
            </div>
        </div>
    </div>
</footer>

</body>
</html>