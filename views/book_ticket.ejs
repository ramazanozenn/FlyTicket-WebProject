<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Book Ticket - FlyTicket</title>
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/css/bootstrap.min.css" rel="stylesheet">
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css">
    <link rel="stylesheet" href="/css/style.css">
</head>
<body class="d-flex flex-column" style="min-height: 100vh; background-color: #f0f2f5;">

<nav class="navbar navbar-dark bg-primary mb-4 shadow-sm">
    <div class="container">
        <a class="navbar-brand fw-bold" href="/">
            <i class="fas fa-plane-departure me-2"></i>FlyTicket
        </a>
    </div>
</nav>

<div class="container py-4 my-auto">
    <div class="row justify-content-center">
        <div class="col-md-8">
            <div class="card shadow-lg p-4 border-0 rounded-4">
                <h2 class="text-center mb-4 fw-bold text-dark">Complete Your Booking</h2>
                
                <div class="alert alert-primary border-0 shadow-sm text-center mb-4 rounded-3 py-4">
                    <div class="d-flex justify-content-around align-items-center">
                        <div class="text-end"><h4 class="mb-0 fw-bold text-primary"><%= flight.from_city %></h4></div>
                        <div class="px-3"><i class="fas fa-plane text-primary fa-2x" style="transform: rotate(-15deg);"></i></div>
                        <div class="text-start"><h4 class="mb-0 fw-bold text-primary"><%= flight.to_city %></h4></div>
                    </div>
                    <div class="mt-3 text-muted">
                        <i class="far fa-calendar-alt me-1"></i> <%= new Date(flight.departure_time).toLocaleString('en-US') %>
                    </div>
                </div>

                <form action="/book/<%= flight._id %>" method="POST">
                    <h5 class="mb-3 border-bottom pb-2 fw-bold text-primary">
                        <i class="fas fa-user-edit me-2"></i>Passenger Information
                    </h5>
                    <div class="row g-3 mb-4">
                        <div class="col-md-6">
                            <label class="form-label fw-semibold small">First Name</label>
                            <input type="text" name="passenger_name" class="form-control" value="<%= user ? user.name : '' %>" required>
                        </div>
                        <div class="col-md-6">
                            <label class="form-label fw-semibold small">Last Name</label>
                            <input type="text" name="passenger_surname" class="form-control" value="<%= user ? user.surname : '' %>" required>
                        </div>
                        <div class="col-md-12">
                            <label class="form-label fw-semibold small">Email Address</label>
                            <input type="email" name="passenger_email" class="form-control" value="<%= user ? user.email : '' %>" required>
                        </div>
                    </div>

                    <h5 class="mb-3 border-bottom pb-2 fw-bold text-primary">
                        <i class="fas fa-suitcase me-2"></i>Flight Options
                    </h5>
                    <div class="row g-3 mb-4">
                        <input type="hidden" name="ticket_quantity" value="1">
                        
                        <div class="col-md-12">
                            <label class="form-label fw-semibold small">Cabin Class</label>
                            <select name="cabin_class" id="cabinClass" class="form-select shadow-sm" onchange="updateTotalPrice()">
                                <option value="Economy">Economy Class</option>
                                <option value="Business">Business Class (+500 TL)</option>
                                <option value="First">First Class (+1200 TL)</option>
                            </select>
                        </div>
                    </div>

                    <h5 class="mb-3 border-bottom pb-2 fw-bold text-primary">
                        <i class="fas fa-credit-card me-2"></i>Payment Details
                    </h5>
                    <div class="row g-3 mb-4">
                        <div class="col-md-12">
                            <label class="form-label fw-semibold small">Cardholder Name</label>
                            <input type="text" 
                                   name="card_holder_name" 
                                   class="form-control" 
                                   placeholder="John Doe" 
                                   pattern="[A-Za-z ]+" 
                                   title="Please enter letters only." 
                                   required>
                        </div>
                        <div class="col-md-6">
                            <label class="form-label fw-semibold small">Card Number</label>
                            <input type="text" 
                                   name="card_number" 
                                   class="form-control" 
                                   placeholder="0000000000000000" 
                                   inputmode="numeric" 
                                   pattern="[0-9]{16}" 
                                   title="Please enter a valid 16-digit card number." 
                                   maxLength="16" 
                                   required>
                        </div>
                        <div class="col-md-3">
                            <label class="form-label fw-semibold small">Expiration</label>
                            <input type="text" 
                                   name="expiry_date" 
                                   class="form-control" 
                                   placeholder="MM/YY" 
                                   pattern="(0[1-9]|1[0-2])\/[0-9]{2}" 
                                   title="Please use MM/YY format (e.g., 05/28)." 
                                   maxLength="5" 
                                   required>
                        </div>
                        <div class="col-md-3">
                            <label class="form-label fw-semibold small">CVC</label>
                            <input type="text" 
                                   name="cvc" 
                                   class="form-control" 
                                   placeholder="123" 
                                   inputmode="numeric" 
                                   pattern="[0-9]{3}" 
                                   title="Please enter a valid 3-digit CVC." 
                                   maxLength="3" 
                                   required>
                        </div>
                    </div>

                    <div class="d-grid gap-2 mt-4">
                        <button type="submit" class="btn btn-primary btn-lg py-3 fw-bold rounded-pill shadow-sm border-0">
                            CONFIRM AND PAY <span id="totalPriceDisplay"><%= flight.price %></span> TL
                        </button>
                    </div>
                </form>
            </div>
        </div>
    </div>
</div>

<footer class="modern-footer">
    <div class="container text-center">
        <a href="https://www.linkedin.com/in/ramazan-%C3%B6zen-6a6488336/" target="_blank"><i class="fab fa-linkedin"></i></a>
        <div class="footer-academic-text">Developed for <strong>CENG 3502 Dynamic Web Course</strong></div>
    </div>
</footer>

<script>
    const basePrice = parseInt("<%= flight.price %>");
    const classSelect = document.getElementById('cabinClass');
    const priceDisplay = document.getElementById('totalPriceDisplay');

    function updateTotalPrice() {
        let extra = 0;
        if (classSelect.value === 'Business') extra = 500;
        else if (classSelect.value === 'First') extra = 1200;
        priceDisplay.innerText = basePrice + extra;
    }
</script>
</body>
</html>